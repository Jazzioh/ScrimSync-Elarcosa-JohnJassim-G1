{% extends "base.html" %}
{% block title %}System Admin Dashboard | ScrimSync{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0">System Admin Dashboard</h2>
        <p class="text-muted mb-0">Manage platform users, role assignments, and account status.</p>
    </div>
    <a href="{% url 'accounts:profile_detail' %}" class="btn btn-outline-dark">Admin Profile</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card shadow-sm text-center p-3">
            <h6 class="text-muted mb-1">Total Users</h6>
            <h3 class="mb-0">{{ total_users }}</h3>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm text-center p-3">
            <h6 class="text-muted mb-1">Team Managers</h6>
            <h3 class="mb-0">{{ manager_count }}</h3>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm text-center p-3">
            <h6 class="text-muted mb-1">Competitive Players</h6>
            <h3 class="mb-0">{{ player_count }}</h3>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm text-center p-3">
            <h6 class="text-muted mb-1">Organizers</h6>
            <h3 class="mb-0">{{ organizer_count }}</h3>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-dark text-white fw-semibold">Registered User Accounts</div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Username</th>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>IGN</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for u in users %}
                <tr>
                    <td class="fw-semibold">{{ u.username }}</td>
                    <td>{{ u.get_full_name|default:"—" }}</td>
                    <td>{{ u.email }}</td>
                    <td><span class="badge bg-secondary">{{ u.get_role_display }}</span></td>
                    <td>{{ u.in_game_name|default:"—" }}</td>
                    <td>
                        {% if u.is_active %}
                            <span class="badge bg-success">Active</span>
                        {% else %}
                            <span class="badge bg-danger">Inactive</span>
                        {% endif %}
                    </td>
                    <td class="text-end">
                        <a href="{% url 'accounts:admin_user_edit' u.pk %}" class="btn btn-sm btn-outline-primary">Edit</a>
                        {% if u.pk != request.user.pk %}
                            <a href="{% url 'accounts:admin_user_delete' u.pk %}" class="btn btn-sm btn-outline-danger">Delete</a>
                        {% endif %}
                    </td>
                </tr>
                {% empty %}
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">No users found.</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}